# Confluence connection settings belong in Cursor MCP:
#   Windows: %USERPROFILE%\.cursor\mcp.json
#   macOS/Linux: ~/.cursor/mcp.json
# Use the mcpServers entry whose args point to this package's src/index.js.
#
# Example:
#   "confluence-sso": {
#     "command": "node",
#     "args": ["C:/path/to/confluence-mcp-oauth/src/index.js"],
#     "env": {
#       "CONFLUENCE_BASE_URL": "https://confluence.company.com",
#       "CONFLUENCE_LOGIN_WAIT_SECONDS": "90"
#     }
#   }
#
# Multiple Confluence sites => multiple MCP entries, each with its own CONFLUENCE_BASE_URL.
# If several entries share the same path to src/index.js, set CONFLUENCE_MCP_SERVER_KEY in mcp.json
# to that server id (e.g. mywiki-local). Run confluence_health_check if REST and the browser disagree.
#
# Auth is SSO-cookie only (run the confluence_login tool once). There is no token mode.
# If browser SSO (confluence_login) never saves a good session: delete
# cookies/session-<server-key>.json under this package and retry, completing SSO fully.

# Optional: background session keep-alive interval in seconds (default 120; 0 disables)
# Pings immediately on start, then every interval on success.
# CONFLUENCE_KEEPALIVE_SECONDS=120

# Optional: after a FAILED ping, retry this quickly (seconds) instead of a full interval (default 15)
# CONFLUENCE_KEEPALIVE_RETRY_SECONDS=15

# Optional: consecutive auth failures before the stale cookie file is auto-deleted (default 3; 0 disables)
# CONFLUENCE_STALE_COOKIE_FAILS=3

# Optional: max attachment download size in bytes (default 5242880)
# CONFLUENCE_MAX_ATTACHMENT_BYTES=

# Optional: comma-separated space keys — when set, search/get/create are limited to those spaces.
# CONFLUENCE_ALLOWED_SPACE_KEYS=WRT,TEAM

# Optional: HTTP retries for 429/502/503 (defaults: 3 retries, 600ms base backoff)
# CONFLUENCE_HTTP_MAX_RETRIES=3
# CONFLUENCE_HTTP_RETRY_MS=600

# Optional: OpenAI-compatible vision for confluence_describe_attachment (image attachments only)
# CONFLUENCE_VISION_API_KEY=
# OPENAI_API_KEY=
# CONFLUENCE_VISION_MODEL=gpt-4o-mini
# CONFLUENCE_VISION_API_BASE=https://api.openai.com/v1

# Optional local overrides (rare)
# NODE_OPTIONS=
