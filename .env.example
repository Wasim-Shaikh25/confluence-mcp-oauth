# Confluence connection settings belong in Cursor MCP only:
# %USERPROFILE%\.cursor\mcp.json → mcpServers.confluence-sso.env
#
# Example mcp.json fragment:
#   "confluence-sso": {
#     "command": "node",
#     "args": ["C:/path/to/confluence-mcp-oauth/src/index.js"],
#     "env": {
#       "CONFLUENCE_BASE_URL": "https://confluence.company.com",
#       "CONFLUENCE_LOGIN_WAIT_SECONDS": "90"
#     }
#   }
#
# Do NOT put CONFLUENCE_PAT (or CONFLUENCE_API_TOKEN) in this file — only in
# %USERPROFILE%\.cursor\mcp.json → mcpServers.confluence-sso.env

# Optional: max attachment download size in bytes (default 5242880)
# CONFLUENCE_MAX_ATTACHMENT_BYTES=

# Optional local overrides (rare): uncomment only if needed
# NODE_OPTIONS=
