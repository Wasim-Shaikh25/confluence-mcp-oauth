{
  "name": "confluence-sso-mcp",
  "version": "0.2.1",
  "description": "Model Context Protocol (MCP) server for Atlassian Confluence: browser SSO cookies for REST API access (with background session keep-alive and stale-cookie cleanup)—works with any reachable site you configure (Cloud or Data Center).",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "atlassian",
    "confluence",
    "confluence-cloud",
    "confluence-server",
    "cursor",
    "sso"
  ],
  "type": "module",
  "bin": {
    "confluence-sso-mcp": "./src/index.js"
  },
  "files": [
    "src/index.js",
    "src/auth.js",
    "src/config.js",
    "src/confluence.js",
    "src/confluence-space-hints.js",
    "src/sso-login-messages.js",
    "src/confluence-paths.js",
    "src/cookie-lock.js",
    "src/cookie-refresh.js",
    "src/session-path.js",
    "tests/confluence-features.test.js",
    "tests/confluence-extras.test.js",
    "tests/setup-env.js",
    "src/mcp-server-discovery.js",
    "scripts/confluence-login.mjs",
    "README.md",
    "CHANGELOG.md",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wasim-Shaikh25/confluence-mcp-oauth.git"
  },
  "homepage": "https://github.com/Wasim-Shaikh25/confluence-mcp-oauth#readme",
  "bugs": {
    "url": "https://github.com/Wasim-Shaikh25/confluence-mcp-oauth/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "login": "node scripts/confluence-login.mjs",
    "test": "node --import ./tests/setup-env.js --test tests/",
    "validate": "node scripts/validate.mjs",
    "install-browser": "node ./node_modules/playwright/cli.js install chromium",
    "prepack": "node -e \"const fs=require('fs');const p='src/index.js';const t=fs.readFileSync(p,'utf8');if(!t.startsWith('#!/usr/bin/env node'))process.exit(1);\"",
    "prepublishOnly": "node scripts/verify-pack-includes-src.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.0.0",
    "diff": "5.2.0",
    "node-fetch": "3.3.2",
    "playwright": "1.43.0"
  }
}
